class quarter_note:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.radius = 15
        self.color = (0, 0, 0)
        self.thickness = 0
        self.start = [x + 13, y]
        self.end = [x + 13, y - 75]

    def make(self):
        pygame.draw.circle(screen, self.color, (self.x, self.y), self.radius, self.thickness)
        pygame.draw.line(screen, self.color, self.start, self.end, 2)


