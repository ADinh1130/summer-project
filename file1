class quarter_note(pygame.sprite.Sprite):
    def __init__(self, x, y, key):
        super().__init__()
        #hitbox check put scalpha when done
        #self.image = pygame.Surface([50, 100])
        #self.image.fill((255,0,0))
        self.image = pygame.Surface([50,100], pygame.SRCALPHA, 32)

        pygame.draw.circle(self.image, (0, 0, 0), (25, 80), 15, 0)
        pygame.draw.line(self.image, (0, 0, 0), [38, 80], [38, 5], 2)

        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y

        self.key = key


class quarter_note_off(pygame.sprite.Sprite):
    def __init__(self, x, y, key):
        super().__init__()

        self.image = pygame.Surface([50,100], pygame.SRCALPHA, 32)

        pygame.draw.circle(self.image, (0, 0, 0), (25, 80), 15, 0)
        pygame.draw.line(self.image, (0, 0, 0), [38, 80], [38, 5], 2)
        pygame.draw.line(self.image, (0, 0, 0), [0, 80], [50, 80], 2)

        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y

        self.key = key


