font = pygame.font.Font('freesansbold.ttf', 32)
text = font.render('Perfect', True, (0,255,0))
textRect = text.get_rect()
textRect.center = (200,420)

# Game loop
running = True
clock = pygame.time.Clock()
note_count = 0
timer = threading.Timer(1, all_active_note_list.add, args = (sheet_music[note_count],))
timer.start()

score = 0

while running:
    #wipe the previous movement
    screen.fill((255,255,255))
    line_num = 0
    #green indicator
    pygame.draw.rect(screen, (0, 255, 0), 
        [160, 450, 80, 240], 0)

    # for loop
    for line in line_start:
        # Drawing the lines 
        # using the draw.line() method
        pygame.draw.line(screen,(0,0,0),line_start[line_num], line_end[line_num], 2)

        # Increasing the value of line_num
        # by 1 after every iteration
        line_num += 1

    if(timer.is_alive() == False):
        #make the note
        note_count += 1
        if(note_count < len(sheet_music)):
            timer = threading.Timer(1, all_active_note_list.add, args = (sheet_music[note_count], ))
            timer.start()

    all_active_note_list.draw(screen)

    for note in all_active_note_list:
        note.rect.x -= 7
    if(len(all_active_note_list.sprites()) > 0):
                note = all_active_note_list.sprites()[0]
                if(note.rect.x <= 110):
                    note.kill() 

    pygame.display.update()
    pygame.display.flip()
    clock.tick(60)
    time.sleep(0.01)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if (event.type == KEYDOWN):
            if(len(all_active_note_list.sprites()) > 0):
                note = all_active_note_list.sprites()[0]
                if(note.rect.x >= 160 and note.rect.x <= 240):
                    for key, value in key_dict.items():
                        if(event.key == value and note.key == key):
                            screen.blit(text, textRect)
                            score += 1
                            note.kill()
        '''elif(event.type == KEYUP):'''

