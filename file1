# might use this for sound input later
#used to hit the note
class detector(pygame.sprite.Sprite):
    def __init__(self, x, y):
        super().__init__()
        #self.image = pygame.Surface([50, 240])
        #self.image.fill((255,0,0))
        self.image = pygame.Surface([50,240], pygame.SRCALPHA, 32)
        pygame.draw.line(self.image, (0, 0, 0), [25, 240], [25, 0], 2)
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y

        
detector_group = pygame.sprite.Group()
detector_group.add(detector(175, 450))

# Game loop
running = True
clock = pygame.time.Clock()
note_count = 0
timer = threading.Timer(1, all_active_note_list.add, args = (sheet_music[note_count],))
timer.start()

score = 0

while running:
    #wipe the previous movement
    screen.fill((255,255,255))
    line_num = 0

    pygame.draw.rect(screen, (0, 0, 255), 
                 [175, 450, 150, 250], 2)

    # for loop
    for line in line_start:
        # Drawing the lines 
        # using the draw.line() method
        pygame.draw.line(screen,(0,0,0),line_start[line_num], line_end[line_num], 2)

        # Increasing the value of line_num
        # by 1 after every iteration
        line_num += 1

    detector_group.draw(screen)

    if(timer.is_alive() == False):
        #make the note
        note_count += 1
        if(note_count < len(sheet_music)):
            timer = threading.Timer(1, all_active_note_list.add, args = (sheet_music[note_count], ))
            timer.start()

    all_active_note_list.draw(screen)

    for note in all_active_note_list:
        note.rect.x -= 7
        if(note.rect.x <= 110):
            note.kill()

    pygame.display.update()
    pygame.display.flip()
    clock.tick(60)
    time.sleep(0.01)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        for note in all_active_note_list:
            #check if note was pressed
            if(event.type == pygame.KEYDOWN and note.rect.x >= 150 and note.rect.x <= 250):
                if(event.key == pygame.K_t and note.key == "c"):
                    score += 1
                    note.kill()
                if (event.key == pygame.K_y and note.key == "d"):
                    score += 1
                    note.kill()
            # checking if key "E" was pressed
                if( event.key == pygame.K_u and note.key == "e"):
                    score += 1
                    note.kill()
            # checking if key "F" was pressed
                if (event.key == pygame.K_i and note.key == "f"):
                    score += 1
                    note.kill()
                if (event.key == pygame.K_o and note.key == "g"):
                    score += 1
                    note.kill()
                if (event.key == pygame.K_p and note.key == "a"):
                    score += 1
                    note.kill()

# Quit Pygame
pygame.quit()
